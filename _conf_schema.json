{
  "repo_path": {
    "type": "string",
    "description": "nzm-wiki 原始仓库路径",
    "hint": "路径必须在 AstrBot 容器内可读，建议以只读方式挂载。",
    "default": "/knowledge/nzm-wiki"
  },
  "source_dirs": {
    "type": "list",
    "description": "知识来源目录",
    "hint": "相对于仓库根目录；默认只查询公开内容 data。",
    "default": [
      "data"
    ]
  },
  "default_max_results": {
    "type": "int",
    "description": "默认最大证据条数",
    "default": 6,
    "slider": {
      "min": 1,
      "max": 12,
      "step": 1
    }
  },
  "default_max_characters": {
    "type": "int",
    "description": "默认最大返回字符数",
    "default": 18000,
    "slider": {
      "min": 4000,
      "max": 40000,
      "step": 1000
    }
  },
  "max_file_size_mb": {
    "type": "int",
    "description": "单个源文件读取上限（MB）",
    "default": 64,
    "slider": {
      "min": 1,
      "max": 128,
      "step": 1
    }
  }
}
